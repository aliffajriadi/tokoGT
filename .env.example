# Environment Variables — BlokMarket
# Salin file ini ke .env dan isi nilainya sebelum menjalankan server

DATABASE_URL="file:./dev.db"
PORT=3000

# Payment Gateway (Pakasir-compatible)
PAYMENT_BASE_URL="https://store.ku.anjay.fun/api/v1"
PAYMENT_API_KEY=            # pk_live_xxxx dari Dashboard > Proyek
PAYMENT_WEBHOOK_SECRET=     # Secret Key webhook dari Proyek yang sama

# Admin Panel Auth
ADMIN_PASSWORD=ganti_password_ini_sebelum_deploy
SESSION_SECRET=ganti_session_secret_random_panjang_ini
NODE_ENV=development