<%
  const fmtRupiah = (n) => 'Rp ' + Number(n).toLocaleString('id-ID');
  const fmtTime = (d) => new Date(d).toLocaleString('id-ID', { day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit' });
  const statusLabel = { PENDING:'Pending', PAID:'Dibayar', DELIVERED:'Terkirim', EXPIRED:'Kadaluarsa', FAILED:'Gagal', REFUNDED:'Dikembalikan' };
  const statuses = ['', 'PENDING', 'PAID', 'DELIVERED', 'EXPIRED', 'FAILED'];
%>
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="shell">
  <%- include('./_sidebar', { activePage }) %>
  <main class="main">
    <div class="topbar">
      <div>
        <h1>Pesanan</h1>
        <p><%= total %> total pesanan</p>
      </div>
    </div>

    <!-- Filter Tabs -->
    <div class="tab-row" style="margin-bottom:20px; flex-wrap:wrap; gap:6px;">
      <% statuses.forEach(s => { %>
        <a href="/admin/pesanan?<%= s ? 'status='+s : '' %>"
           class="tab <%= currentStatus === s ? 'active' : '' %>">
          <%= s ? (statusLabel[s] || s) : 'Semua' %>
        </a>
      <% }) %>
    </div>

    <div class="panel">
      <table>
        <thead><tr><th>Invoice</th><th>Kontak</th><th>Produk</th><th>Total</th><th>Status</th><th>Waktu</th><th>Bayar</th></tr></thead>
        <tbody>
          <% if (orders.length === 0) { %>
            <tr><td colspan="7" style="text-align:center; color:var(--text-dim); padding:28px;">Tidak ada pesanan.</td></tr>
          <% } %>
          <% orders.forEach(o => { %>
            <tr>
              <td class="inv"><%= o.invoiceCode %></td>
              <td style="font-size:13px; color:var(--text-dim)"><%= o.contact %></td>
              <td style="font-size:13px;">
                <% o.items.forEach((item, idx) => { %>
                  <%= item.product.name %><% if (item.qty > 1) { %> ×<%= item.qty %><% } %><% if (idx < o.items.length-1) { %>,<br><% } %>
                <% }) %>
              </td>
              <td class="mono"><%= fmtRupiah(o.totalPrice) %></td>
              <td><span class="status-badge <%= o.status %>"><%= statusLabel[o.status] || o.status %></span></td>
              <td style="font-size:12px; color:var(--text-dim)"><%= fmtTime(o.createdAt) %></td>
              <td style="font-size:12px; color:var(--text-dim)"><%= o.paidAt ? fmtTime(o.paidAt) : '—' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (total > 25) { %>
    <div style="display:flex; gap:8px; justify-content:center; margin-top:8px;">
      <% if (currentPage > 1) { %>
        <a href="/admin/pesanan?<%= currentStatus ? 'status='+currentStatus+'&' : '' %>page=<%= currentPage-1 %>" class="btn btn-ghost btn-sm">← Prev</a>
      <% } %>
      <span style="padding:7px 14px; font-size:12.5px; color:var(--text-dim);">Hal. <%= currentPage %> / <%= Math.ceil(total/25) %></span>
      <% if (currentPage * 25 < total) { %>
        <a href="/admin/pesanan?<%= currentStatus ? 'status='+currentStatus+'&' : '' %>page=<%= currentPage+1 %>" class="btn btn-ghost btn-sm">Next →</a>
      <% } %>
    </div>
    <% } %>
  </main>
</div>
<script src="https://unpkg.com/lucide@latest"></script>
<script>lucide.createIcons();</script>
</body>
</html>
